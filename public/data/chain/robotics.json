{
 "id": "robotics",
 "name": "机器人链",
 "en": "Robotics",
 "oneLiner": "从关节里的减速器，到进厂干活的本体",
 "status": "ready",
 "draft": true,
 "note": "环节按「一个关节 = 五件套」拆分：减速器 / 丝杠 / 无框力矩电机 / 编码器 / 力矩传感器 / 轴承，再加上关节总成、灵巧手、本体与落地。依据：Morgan Stanley 与 Schaeffler 的 BOM 拆解（执行器约占整机成本 50–56%）、招商证券 Optimus 旋转执行器拆解、公司公告与供应链报道。仍不含市占率与财务数字，未上市公司标注为非上市。",
 "segments": [
  {
   "id": "reducer",
   "name": "减速器",
   "gloss": "谐波管轻载、RV 管重载",
   "output": "谐波 / RV 减速器",
   "feeds": [
    "joint"
   ]
  },
  {
   "id": "screw",
   "name": "丝杠与导轨",
   "gloss": "把旋转变成直线推力，腿部重载关节用行星滚柱丝杠",
   "output": "行星滚柱丝杠、微型滚珠丝杠",
   "feeds": [
    "joint"
   ]
  },
  {
   "id": "motor",
   "name": "无框力矩电机",
   "gloss": "关节动力的本体，要求高扭矩密度",
   "output": "无框力矩电机、驱动器",
   "feeds": [
    "joint"
   ]
  },
  {
   "id": "encoder",
   "name": "编码器",
   "gloss": "双编码器是当前主流方案",
   "output": "绝对式 / 增量式编码器",
   "feeds": [
    "joint"
   ]
  },
  {
   "id": "bearing",
   "name": "轴承",
   "gloss": "交叉滚子与角接触，撑住关节",
   "output": "交叉滚子轴承、薄壁轴承",
   "feeds": [
    "joint"
   ]
  },
  {
   "id": "joint",
   "name": "关节总成",
   "gloss": "把五件套装成可交付的执行器",
   "output": "旋转 / 线性执行器总成",
   "feeds": [
    "body"
   ]
  },
  {
   "id": "sensor",
   "name": "力矩与触觉传感",
   "gloss": "六维力、MEMS 触觉、3D 视觉",
   "output": "力控与本体感知",
   "feeds": [
    "body"
   ]
  },
  {
   "id": "hand",
   "name": "灵巧手与末端",
   "gloss": "多指手、微型驱动、夹爪",
   "output": "操作能力",
   "feeds": [
    "body"
   ]
  },
  {
   "id": "body",
   "name": "本体集成",
   "gloss": "把零件装成整机",
   "output": "人形 / 四足 / 协作臂",
   "feeds": [
    "deploy"
   ]
  },
  {
   "id": "deploy",
   "name": "场景落地",
